rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permanent rule: Only allow logged-in users to read and write data.
    // The specific workflow permissions (DS, JS, Admin, Finaliser) 
    // are enforced by the application's UI and logic.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
