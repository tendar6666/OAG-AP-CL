{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "public": "out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "headers": [
        {
          "source": "**/*.@(html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ],
      "site": "oagonline",
      "revisionsPerSite": 5
    },
    {
      "site": "oag-audit-management-online",
      "public": "redirect-dummy",
      "redirects": [
        {
          "source": "**",
          "destination": "https://oagonline.web.app",
          "type": 301
        }
      ],
      "revisionsPerSite": 5
    }
  ]
}